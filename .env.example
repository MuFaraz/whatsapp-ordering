# -----------------------------------------------------------------------------
# Bun & Brew Menu — environment variables
# Copy this file to `.env.local` for local development and fill in real values.
# NEVER commit `.env.local` or any real keys.
# -----------------------------------------------------------------------------

# Supabase project URL (Project Settings → API / Data API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase *publishable* key (Project Settings → API Keys → "Publishable key",
# starts with `sb_publishable_`). It is safe in the browser because Row Level
# Security protects every table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Legacy alternative: older projects can use the JWT "anon" key instead.
# Only one of PUBLISHABLE_KEY / ANON_KEY is needed (publishable wins if both set).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Public base URL of the app, WITHOUT a trailing slash. Used for QR codes,
# public menu links and auth email redirects.
#   Local:      http://localhost:3000
#   Production: https://your-project.vercel.app
# If omitted on Vercel, the production URL Vercel provides is used automatically.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: WhatsApp number (international format, e.g. +923001234567) used by
# the *demo* restaurant's "Order on WhatsApp" button. Set it to your own number
# so you can demo a live order to a restaurant owner. If empty, WhatsApp opens
# with the message prefilled and lets the user pick a chat.
NEXT_PUBLIC_DEMO_WHATSAPP_NUMBER=

# Optional: your sales/support contact, shown on the landing & pricing pages.
NEXT_PUBLIC_SALES_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# NOTE: This app does NOT need the Supabase service-role / secret key.
# Do not add it here and never prefix it with NEXT_PUBLIC_.
